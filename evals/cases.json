{
  "_comment": [
    "Eval manifest (2R.6). Paths are relative to this file. Every registry",
    "doc_type has a synthetic twin, plus the MultiCover golden case and an",
    "unknown-document case. expected_fields hold ground-truth values (the",
    "fixtures are synthetic, so ground truth is known); comparison is",
    "lenient on formatting (case, whitespace, currency symbols), strict on",
    "value. Cases run in isolated temp roots — order carries no state."
  ],
  "cases": [
    {
      "name": "renewal_quote_motor",
      "file": "../examples/motor_renewal_quote.txt",
      "expected_doc_type": "renewal_quote",
      "expected_outcome": "accepted",
      "expected_lines": [
        {"product": "motor", "annual_premium": 378.90, "renewal_date": "2026-10-14"}
      ]
    },
    {
      "name": "multicover_golden",
      "file": "../examples/multicover_renewal_invitation.txt",
      "expected_doc_type": "renewal_quote",
      "expected_outcome": "review",
      "expect_reason_contains": ["multi-line"],
      "expected_lines": [
        {"product": "motor", "annual_premium": 412.50},
        {"product": "home", "annual_premium": 238.20}
      ],
      "expected_stated_total": 650.70
    },
    {
      "name": "policy_schedule",
      "file": "../examples/motor_policy_schedule.txt",
      "expected_doc_type": "policy_schedule",
      "expected_outcome": "accepted",
      "expected_fields": {
        "policy_end_date": "2026-10-14",
        "annual_premium": 352.40,
        "vehicle_registration": "XY19 ZAB",
        "policy_number": "SM-0000042",
        "provider": "SwiftSure Insurance Ltd",
        "ncd_years": 6
      }
    },
    {
      "name": "certificate",
      "file": "fixtures/motor_certificate.txt",
      "expected_doc_type": "certificate",
      "expected_outcome": "stored",
      "expected_fields": {
        "policy_number": "SM-0000042",
        "vehicle_registration": "XY19 ZAB",
        "policy_end_date": "2026-10-14"
      }
    },
    {
      "name": "ncd_letter",
      "file": "fixtures/ncd_letter.txt",
      "expected_doc_type": "ncd_letter",
      "expected_outcome": "accepted",
      "expected_fields": {
        "ncd_years": 6,
        "policy_number": "SM-0000042"
      }
    },
    {
      "name": "policy_wording",
      "file": "../examples/motor_policy_wording.txt",
      "expected_doc_type": "policy_wording",
      "expected_outcome": "stored"
    },
    {
      "name": "claim_evidence",
